{
  "compilerOptions": {
    "target": "ES2022",
    "useDefineForClassFields": true,
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "types": ["node"],
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noEmit": true,
    "skipLibCheck": true
  },
  "include": [
    "src",
    "scripts",
    "tests/unit",
    "tests/helpers",
    "tests/e2e",
    "playwright.config.ts",
    "vite.config.ts",
    "vitest.unit.config.ts"
  ]
}
