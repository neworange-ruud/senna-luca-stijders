{
  "name": "senna-luca-strijders",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "concurrently --kill-others --names web,worker --prefix-colors cyan,magenta \"npm:dev:web\" \"npm:dev:worker\"",
    "dev:web": "cross-env APP_ENV=development vite --host 127.0.0.1 --port 3000 --strictPort",
    "dev:vercel": "cross-env APP_ENV=development npx --yes vercel@latest dev --listen 3000",
    "dev:worker": "cross-env CLOUDFLARE_LOAD_DEV_VARS_FROM_DOT_ENV=false wrangler dev --config wrangler.toml --port 8787 --local --persist-to .wrangler/state --var SESSION_SIGNING_SECRET:local-session-secret-change-outside-development --var WORKER_INTERNAL_SECRET:local-worker-secret-change-outside-development",
    "dev:e2e:web": "vite --host 127.0.0.1 --port 4173 --strictPort",
    "dev:e2e:worker": "cross-env CLOUDFLARE_LOAD_DEV_VARS_FROM_DOT_ENV=false wrangler dev --config wrangler.toml --port 8787 --local --var E2E_IN_MEMORY:true --var SESSION_SIGNING_SECRET:local-session-secret-change-outside-development --var WORKER_INTERNAL_SECRET:local-worker-secret-change-outside-development",
    "build": "npm run typecheck && vite build",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.server.json && tsc --noEmit -p tsconfig.worker.json",
    "lint": "eslint . --max-warnings 0",
    "format": "prettier --write --ignore-unknown .",
    "format:check": "prettier --check --ignore-unknown .",
    "test": "npm run test:unit && npm run test:integration",
    "test:unit": "vitest run --config vitest.unit.config.ts",
    "test:unit:coverage": "vitest run --config vitest.unit.config.ts --coverage",
    "test:integration": "npm run test:integration:node && npm run test:integration:worker",
    "test:integration:node": "vitest run --config vitest.integration.config.ts",
    "test:integration:worker": "cross-env CLOUDFLARE_LOAD_DEV_VARS_FROM_DOT_ENV=false vitest run --config vitest.worker.config.ts",
    "test:e2e": "playwright test --project=chromium",
    "test:e2e:webkit": "playwright test --project=webkit",
    "test:soak": "cross-env REALTIME_SAMPLES=6400 REALTIME_INTERVAL_MS=33 playwright test tests/e2e/realtime.spec.ts --project=chromium",
    "simulation:replay": "tsx scripts/replay-simulation.ts",
    "check": "npm run format:check && npm run lint && npm run test && npm run build",
    "assets": "tsx scripts/prepare-assets.ts",
    "test:production": "playwright test --config playwright.production.config.ts"
  },
  "devDependencies": {
    "@cloudflare/vitest-pool-workers": "^0.22.0",
    "@cloudflare/workers-types": "^5.20260819.1",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.62.1",
    "@types/node": "^24.0.0",
    "@vitest/coverage-v8": "^4.1.11",
    "concurrently": "^10.0.5",
    "cross-env": "^10.1.0",
    "eslint": "^10.8.1",
    "prettier": "^3.9.6",
    "tsx": "^4.23.12",
    "typescript": "^5.9.0",
    "typescript-eslint": "^8.67.0",
    "vite": "^8.2.1",
    "vitest": "^4.1.10",
    "wrangler": "^4.124.0"
  },
  "dependencies": {
    "@upstash/redis": "^1.38.2"
  }
}
